{%- comment -%}
  ─────────────────────────────────────────────────────────────────
  CLAUDIO — Footer
  Fondo negro. Logo (3 partes con punto en accent) + tagline +
  columnas de links (blocks) + bloque RGPD + legal con links a
  policies de Shopify + socials (blocks).
  ─────────────────────────────────────────────────────────────────
{%- endcomment -%}

<footer class="claudio-footer" id="claudio-footer">
  <div class="claudio-footer__top">
    <div class="claudio-footer__brand">
      <div class="claudio-footer__logo">
        {{- section.settings.logo_main -}}
        <span>{{- section.settings.logo_accent -}}</span>
        {{- section.settings.logo_suffix -}}
      </div>
      {%- if section.settings.tagline != blank -%}
        <p class="claudio-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    <div class="claudio-footer__cols">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="claudio-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <span class="claudio-footer__col-title">{{ block.settings.title }}</span>
            {%- endif -%}
            {%- for i in (1..3) -%}
              {%- assign label_key = 'link_' | append: i | append: '_label' -%}
              {%- assign url_key   = 'link_' | append: i | append: '_url' -%}
              {%- assign label = block.settings[label_key] -%}
              {%- assign url   = block.settings[url_key] -%}
              {%- if label != blank -%}
                {%- if url contains 'http' -%}
                  <a href="{{ url }}" target="_blank" rel="noopener">{{ label }}</a>
                {%- else -%}
                  <a href="{{ url }}">{{ label }}</a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.privacy_text != blank -%}
    <div class="claudio-footer__middle">
      <p class="claudio-footer__privacy-title">{{ section.settings.privacy_title }}</p>
      <div class="claudio-footer__privacy-text">{{ section.settings.privacy_text }}</div>
    </div>
  {%- endif -%}

  <div class="claudio-footer__bottom">
    <span class="claudio-footer__legal">
      {{ section.settings.copyright }}
      {%- if shop.privacy_policy != blank -%}
        &nbsp;·&nbsp;<a href="{{ shop.privacy_policy.url }}">Política de privacidad</a>
      {%- endif -%}
      {%- if shop.refund_policy != blank -%}
        &nbsp;·&nbsp;<a href="{{ shop.refund_policy.url }}">Política de devoluciones</a>
      {%- endif -%}
      {%- if shop.shipping_policy != blank -%}
        &nbsp;·&nbsp;<a href="{{ shop.shipping_policy.url }}">Política de envíos</a>
      {%- endif -%}
      {%- if shop.terms_of_service != blank -%}
        &nbsp;·&nbsp;<a href="{{ shop.terms_of_service.url }}">Términos del servicio</a>
      {%- endif -%}
      {%- if shop.legal_notice != blank -%}
        &nbsp;·&nbsp;<a href="{{ shop.legal_notice.url }}">Aviso legal</a>
      {%- endif -%}
      {%- if section.settings.cookies_url != blank -%}
        &nbsp;·&nbsp;<a href="{{ section.settings.cookies_url }}">Política de cookies</a>
      {%- endif -%}
    </span>
    <div class="claudio-footer__socials">
      {%- for block in section.blocks -%}
        {%- if block.type == 'social' -%}
          <a class="claudio-footer__social" href="{{ block.settings.url }}" {{ block.shopify_attributes }} data-claudio-reveal>
            <span class="claudio-footer__social-label">{{ block.settings.label }}</span>
            <img class="claudio-footer__social-logo" src="{{ 'claudio-logo.svg' | asset_url }}" alt="Claudio" aria-hidden="true" width="82" height="22">
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% stylesheet %}
.claudio-footer {
  background: #000; padding: 72px 72px 40px;
  font-family: 'Inter', sans-serif;
}
.claudio-footer__top {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding-bottom: 48px; border-bottom: 1px solid rgba(255,255,255,0.07);
  gap: 48px;
}
.claudio-footer__brand {
  display: flex; flex-direction: column; gap: 16px; max-width: 300px;
}
.claudio-footer__logo {
  font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
  font-size: 2.8rem; text-transform: none; color: #fff;
  letter-spacing: 0.02em; line-height: 1;
}
.claudio-footer__logo span {
  color: var(--accent, #EC6768);
  transition: color 3s ease;
}
.claudio-footer__tagline {
  font-size: 0.78rem; font-weight: 300;
  color: rgba(255,255,255,0.7); line-height: 1.65; margin: 0;
}
.claudio-footer__cols { display: flex; gap: 64px; }
.claudio-footer__col { display: flex; flex-direction: column; gap: 16px; }
.claudio-footer__col-title {
  font-size: 0.6rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
  color: rgba(255,255,255,0.55);
}
.claudio-footer__col a {
  font-size: 0.78rem; font-weight: 300; color: rgba(255,255,255,0.72);
  text-decoration: none; transition: color 0.2s; display: block;
}
.claudio-footer__col a:hover { color: #fff; }

.claudio-footer__middle {
  padding: 32px 0; border-bottom: 1px solid rgba(255,255,255,0.07);
}
.claudio-footer__privacy-title {
  font-size: 0.6rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase;
  color: rgba(255,255,255,0.55); margin-bottom: 12px;
}
.claudio-footer__privacy-text {
  font-size: 0.7rem; font-weight: 300; color: rgba(255,255,255,0.6);
  line-height: 1.7; max-width: 720px;
}
.claudio-footer__privacy-text a {
  color: rgba(255,255,255,0.75); text-decoration: underline; transition: color 0.2s;
}
.claudio-footer__privacy-text a:hover { color: #fff; }

.claudio-footer__bottom {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 28px; gap: 24px; flex-wrap: wrap;
}
.claudio-footer__legal {
  font-size: 0.65rem; color: rgba(255,255,255,0.55); letter-spacing: 0.05em;
}
.claudio-footer__legal a {
  color: inherit; text-decoration: underline;
}
.claudio-footer__legal a:hover { color: #fff; }
.claudio-footer__socials { display: flex; gap: 20px; align-items: center; }
.claudio-footer__social {
  /* Texto y logo apilados en la misma celda → ocupan exactamente el mismo
     espacio. Al hacer toggle, uno se desvanece y el otro aparece en el sitio. */
  display: inline-grid;
  grid-template-columns: 1fr;
  align-items: center; justify-items: end;
  font-size: 0.7rem; color: rgba(255,255,255,0.65);
  text-decoration: none; transition: color 0.2s;
}
.claudio-footer__social:hover { color: var(--accent, #EC6768); }
.claudio-footer__social-label,
.claudio-footer__social-logo {
  grid-area: 1 / 1;
  transition: opacity 0.6s ease;
}
.claudio-footer__social-logo {
  height: 22px; width: auto;
  opacity: 0;
  pointer-events: none;
  filter: invert(1);
}
.claudio-footer__social.is-revealed .claudio-footer__social-label { opacity: 0; }
.claudio-footer__social.is-revealed .claudio-footer__social-logo { opacity: 0.9; }

@media (max-width: 768px) {
  .claudio-footer { padding: 48px 24px 32px; }
  .claudio-footer__top { flex-direction: column; gap: 36px; padding-bottom: 36px; }
  .claudio-footer__brand { max-width: 100%; }
  .claudio-footer__cols { gap: 32px; flex-wrap: wrap; }
  .claudio-footer__bottom { flex-direction: column; align-items: flex-start; gap: 16px; }
}
{% endstylesheet %}

<script>
  (function(){
    document.querySelectorAll('.claudio-footer__social[data-claudio-reveal]').forEach(function(el){
      el.addEventListener('click', function(e){
        e.preventDefault();
        el.classList.toggle('is-revealed');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Claudio Footer",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    { "type": "text", "id": "logo_main",   "label": "Logo — parte 1", "default": "soyclaudio" },
    { "type": "text", "id": "logo_accent", "label": "Logo — parte 2 (accent)", "default": "." },
    { "type": "text", "id": "logo_suffix", "label": "Logo — parte 3", "default": "es" },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "• encontrado • pintado • dejado en la calle •"
    },

    {
      "type": "header",
      "content": "Bloque RGPD"
    },
    { "type": "text",     "id": "privacy_title", "label": "Título RGPD", "default": "Privacidad y datos" },
    { "type": "richtext", "id": "privacy_text",  "label": "Texto RGPD",
      "default": "<p>Al suscribirte a la lista de correo, aceptas que Claudio trate tu dirección de email con el único fin de enviarte comunicaciones sobre drops, obras y novedades. Tus datos no se ceden a terceros. Puedes darte de baja en cualquier momento mediante el enlace de cada correo o escribiéndonos a <a href=\"mailto:hipermodernism@gmail.com\">hipermodernism@gmail.com</a>. Tratamiento conforme al RGPD y la LOPDGDD.</p>" },

    {
      "type": "header",
      "content": "Línea legal"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 Claudio — Madrid"
    },
    {
      "type": "paragraph",
      "content": "Privacy, devoluciones, envíos, términos y aviso legal se enlazan automáticamente desde Settings → Policies de Shopify."
    },
    {
      "type": "url",
      "id": "cookies_url",
      "label": "URL Política de cookies",
      "info": "Crea la página manualmente en Online Store → Pages (sugerencia: /pages/politica-de-cookies). Shopify no tiene este campo en Policies."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "title", "label": "Título columna" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 — texto" },
        { "type": "url",  "id": "link_1_url",   "label": "Link 1 — URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 — texto" },
        { "type": "url",  "id": "link_2_url",   "label": "Link 2 — URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 — texto" },
        { "type": "url",  "id": "link_3_url",   "label": "Link 3 — URL" }
      ]
    },
    {
      "type": "social",
      "name": "Link social",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
